# Template môi trường - Copy file này thành .env và điền thông tin thật

# Supabase Project URL (lấy từ Project Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (lấy từ Project Settings > API > Publishable Key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
