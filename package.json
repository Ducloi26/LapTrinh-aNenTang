{
  "name": "moodflow-workspace",
  "version": "1.0.0",
  "description": "MoodFlow - Ứng dụng Trị liệu Âm nhạc Cá nhân hóa Đa nền tảng",
  "private": true,
  "scripts": {
    "start": "npm --prefix frontend start --",
    "web": "npm --prefix frontend run web --",
    "android": "npm --prefix frontend run android --",
    "ios": "npm --prefix frontend run ios --",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend test",
    "test:db": "npm --prefix supabase test",
    "dev:backend": "npm --prefix backend run dev",
    "install:all": "cd frontend && npm install && cd ../backend && npm install && cd ../supabase && npm install"
  }
}
